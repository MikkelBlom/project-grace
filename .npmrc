# better-sqlite3 (the only native module) must be built for Electron's ABI, not
# Node's: Grace runs inside Electron, whose bundled Node lacks node:sqlite.
# These tell prebuild-install to fetch the prebuilt Electron binary (no compiler
# needed). Standalone Node tooling uses node:sqlite, so it doesn't need this.
# Bump `target` if the electron devDependency version changes.
runtime=electron
target=30.5.1
disturl=https://electronjs.org/headers
build_from_source=false
