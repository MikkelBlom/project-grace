# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
*.js.map
*.d.ts.map
# TS artifacts emitted next to sources (renderer/*.js is NOT under src/, so it's kept)
packages/**/src/**/*.js
packages/**/src/**/*.d.ts
packages/**/src/**/*.cjs
shared/src/**/*.js
shared/src/**/*.d.ts

# Secrets
.env
.env.local

# Logs, runtime data, downloaded models (all regenerated)
*.log
logs/
data/
models/

# Python bytecode
__pycache__/

# Offline pip/model download cache (large, regenerable)
offline-cache/

# Test/benchmark audio clips (binary, transient)
*.wav

# Grace runtime data (on new machine)
~/Grace/

# ChromaDB vector store (runtime data, regenerated)
docker/

# Throwaway scratch scripts
scratch/

# Separate nested project repo — must not be embedded in the grace repo
odysseus/
